<dialog class="lb" id="lightbox" aria-label="Photo viewer">
  <figure class="lb-fig"></figure>
  <div class="lb-bar">
    <p class="lb-cap" id="lb-cap"></p>
    <div class="lb-nav">
      <button class="lb-btn" type="button" id="lb-prev"><span class="sr-only">Previous photo</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"></path></svg></button>
      <button class="lb-btn" type="button" id="lb-next"><span class="sr-only">Next photo</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"></path></svg></button>
    </div>
  </div>
  <button class="lb-btn lb-x" type="button" id="lb-close"><span class="sr-only">Close photo</span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
</dialog>
