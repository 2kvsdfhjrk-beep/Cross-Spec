# Copy to .env for local builds, or set these in Netlify: Site configuration > Environment variables.
# None of these are secrets, but they differ between sites, so they are not hard-coded.

# Cloudflare Web Analytics site token (Cloudflare dashboard > Analytics & Logs > Web Analytics > Add a site).
# Leave empty to build without analytics. The beacon only loads on the production deploy.
PUBLIC_CF_BEACON_TOKEN=

# Optional: only needed if you verify Google Search Console with a meta tag instead of a DNS TXT record.
# Paste just the content value, e.g. abc123... from <meta name="google-site-verification" content="abc123...">
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Bing Webmaster Tools meta tag value (msvalidate.01). Bing can also import from Search Console.
PUBLIC_BING_SITE_VERIFICATION=

# Set automatically by Netlify: production, deploy-preview or branch-deploy.
# Anything other than "production" builds with X-Robots-Tag: noindex. You do not need to set it yourself.
# CONTEXT=
